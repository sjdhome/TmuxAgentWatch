    "No Agent Panes" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 Agent 面板"
          }
        }
      }
    },
    "No GUI terminal on this Mac is attached to tmux session “%@” — the session may be detached, or attached only from SSH. Attach to it from a local terminal app first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上没有 GUI 终端连接到 tmux 会话“%@”——该会话可能处于 detach 状态，或仅从 SSH 连接。请先在本机终端应用中 attach 到该会话。"
          }
        }
      }
    },
    "No tmux pane is currently running a known AI coding agent." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前没有 tmux 面板在运行已知的 AI 编程 Agent。"
          }
        }
      }
    },
    "Retrying every 2 seconds." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
